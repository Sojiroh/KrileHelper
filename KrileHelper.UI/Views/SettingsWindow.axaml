<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KrileHelper.UI.ViewModels"
        xmlns:svc="clr-namespace:KrileHelper.UI.Services"
        x:Class="KrileHelper.UI.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Krile Settings"
        Width="540" Height="760" MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#FF1A1A1F">

    <Border Padding="16">
      <ScrollViewer Name="SettingsScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="{Binding Viewport.Width, ElementName=SettingsScroll}">

            <!-- Overlay tabs -->
            <Border Background="#FF26262C" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Overlay tabs" Foreground="#E5E5E5" FontWeight="SemiBold" FontSize="14"
                               AutomationProperties.Name="Overlay tabs"/>
                    <TextBlock Text="Choose which chat channels appear in each overlay tab. Tabs are independent filters, so a channel can appear in more than one tab."
                               Foreground="#888" FontSize="11" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <ComboBox x:Name="TabSelector" Grid.Column="0" ItemsSource="{Binding TabEditor.Tabs}"
                                  SelectedItem="{Binding TabEditor.SelectedTab}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Overlay tab selection">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="vm:ChatTabEditorTabViewModel">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="AddTabButton" Grid.Column="1" Content="Add" Command="{Binding TabEditor.AddTabCommand}"
                                AutomationProperties.Name="Add overlay tab"/>
                        <Button x:Name="DeleteTabButton" Grid.Column="2" Content="Delete" Command="{Binding TabEditor.DeleteTabCommand}"
                                IsEnabled="{Binding TabEditor.CanDeleteTab}"
                                AutomationProperties.Name="Delete overlay tab"/>
                    </Grid>

                    <TextBox x:Name="TabName" Text="{Binding TabEditor.SelectedTab.Name, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="Tab name" AutomationProperties.Name="Overlay tab name"/>
                    <CheckBox x:Name="IncludeAllChannels" Content="Include all channels (including future channels)"
                              IsChecked="{Binding TabEditor.SelectedTab.IncludeAllChannels}"
                              Foreground="#CCC" AutomationProperties.Name="Include all overlay channels"/>
                    <TextBlock Text="When this is off, choose a custom set below. An empty custom filter is allowed and shows no chat lines."
                               Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="No channels are selected, so this custom tab will stay empty."
                               IsVisible="{Binding TabEditor.HasEmptyFilter}"
                               Foreground="#D0A84B" FontSize="11" TextWrapping="Wrap"/>

                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TabChannels" ItemsSource="{Binding TabEditor.Channels}"
                                      IsEnabled="{Binding TabEditor.SelectedTab.IsCustomFilter}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ChatTabEditorChannelViewModel">
                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              AutomationProperties.Name="{Binding Name}"/>
                                    <Ellipse Grid.Column="1" Width="10" Height="10" Fill="{Binding Color}"
                                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Name}" Foreground="#DDD"/>
                                        <TextBlock Text="{Binding Code}" Foreground="#666" FontFamily="monospace" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="This changes only tab visibility. Global Show and Translate below still control privacy and translation for every tab."
                               Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Translation -->
            <Border Background="#FF26262C" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Translation" Foreground="#E5E5E5" FontWeight="SemiBold" FontSize="14"/>

                    <ComboBox ItemsSource="{Binding EngineOptions}" SelectedItem="{Binding SelectedEngine}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Translation engine">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="svc:EngineOption">
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding EngineHelp}" Foreground="#AAA" FontSize="12" TextWrapping="Wrap"/>
                    <StackPanel Spacing="4" IsVisible="{Binding SupportsApiKey}">
                        <TextBlock Text="API key" Foreground="#AAA"/>
                        <TextBox Text="{Binding ApiKey}" PasswordChar="•" Watermark="Provider API key"
                                 AutomationProperties.Name="API key"/>
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding SupportsEndpoint}">
                        <TextBlock Text="Server endpoint" Foreground="#AAA"/>
                        <TextBox Text="{Binding Endpoint}" Watermark="{Binding EndpointHint}"
                                 AutomationProperties.Name="Server endpoint"/>
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding SupportsModel}">
                        <TextBlock Text="Model" Foreground="#AAA"/>
                        <TextBox Text="{Binding Model}" Watermark="{Binding ModelHint}" AutomationProperties.Name="Model"/>
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding SupportsRegion}">
                        <TextBlock Text="Region / folder ID" Foreground="#AAA"/>
                        <TextBox Text="{Binding Region}" AutomationProperties.Name="Region or folder ID"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <TextBlock Text="Source language" Foreground="#AAA"/>
                        <TextBlock Grid.Column="1" Text="Translate to" Foreground="#AAA" Margin="8,0,0,0"/>
                        <ComboBox Grid.Row="1" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}"
                                  HorizontalAlignment="Stretch" Margin="0,4,4,0" AutomationProperties.Name="Source language">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="svc:LanguageOption"><TextBlock Text="{Binding Display}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding SelectedTarget}"
                                  HorizontalAlignment="Stretch" Margin="4,4,0,0" AutomationProperties.Name="Target language">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="svc:LanguageOption"><TextBlock Text="{Binding Display}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <CheckBox Content="Translate NPC speaker names" IsChecked="{Binding TranslateNpcNames}" Foreground="#CCC"/>
                    <CheckBox Content="Translate player speaker names" IsChecked="{Binding TranslatePlayerNames}" Foreground="#CCC"/>
                    <TextBlock Text="Your character's name and cross-world names in messages are protected. Only explicitly enabled channels are sent to the selected service; local engines never fall back to a cloud service."
                               Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="#FF26262C" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Live dialogue" Foreground="#E5E5E5" FontWeight="SemiBold" FontSize="14"/>
                    <CheckBox Content="Read dialogue, subtitles, bubbles and choices live"
                              IsChecked="{Binding LiveDialogueEnabled}" Foreground="#CCC"/>
                    <CheckBox Content="Place translations over the game's dialogue boxes"
                              IsChecked="{Binding DialogueOverlayEnabled}" Foreground="#CCC"
                              IsEnabled="{Binding LiveDialogueEnabled}"/>
                    <TextBlock Text="The aligned overlay is click-through and follows the game's UI. Speech bubbles stay in the chat window. Requires an accessible X11/XWayland game window; compositor stacking rules still apply."
                               Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="#FF26262C" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Hand-written Russian translations" Foreground="#E5E5E5" FontWeight="SemiBold" FontSize="14"/>
                    <CheckBox Content="Look up reference translations before using an engine"
                              IsChecked="{Binding ReferenceEnabled}" Foreground="#CCC"/>
                    <TextBlock Text="Applies only when the target is Russian. Missing lines use your selected engine. Downloading the XIV Rus dataset can use hundreds of megabytes."
                               Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="Game language for the reference index" Foreground="#AAA"/>
                    <ComboBox ItemsSource="{Binding GameLanguageOptions}" SelectedItem="{Binding SelectedGameLanguage}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Reference game language">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="svc:LanguageOption"><TextBlock Text="{Binding Display}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Download / update index" Command="{Binding UpdateReferenceCommand}"/>
                        <Button Content="Cancel" Command="{Binding UpdateReferenceCancelCommand}"
                                IsVisible="{Binding UpdateReferenceCommand.IsRunning}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ReferenceStatus}" Foreground="#AAA" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Window -->
            <Border Background="#FF26262C" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Window" Foreground="#E5E5E5" FontWeight="SemiBold" FontSize="14"/>

                    <CheckBox Content="Always on top" IsChecked="{Binding Topmost}" Foreground="#CCC"/>

                    <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Background opacity" Foreground="#AAA"/>
                            <TextBlock Grid.Column="1" Text="{Binding BackgroundOpacity, StringFormat='{}{0:P0}'}" Foreground="#888"/>
                        </Grid>
                        <Slider Minimum="0.10" Maximum="1.00" Value="{Binding BackgroundOpacity}" TickFrequency="0.05"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Channels -->
            <Border Background="#FF26262C" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Channels" Foreground="#E5E5E5" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="Toggle Show to hide a channel entirely. Toggle Translate to suppress translation but still show it."
                               Foreground="#888" FontSize="11" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*,80,80" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Text="Channel" Foreground="#888" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="Show" Foreground="#888" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Translate" Foreground="#888" FontSize="11" HorizontalAlignment="Center"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ChannelSettingViewModel">
                                <Grid ColumnDefinitions="*,80,80" Margin="0,2">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#DDD"/>
                                        <TextBlock Text="{Binding Code}" Foreground="#666" FontFamily="monospace" FontSize="10"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Show}" HorizontalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding Translate}" HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Settings save automatically." Foreground="#666" FontSize="11" HorizontalAlignment="Center"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
</Window>
