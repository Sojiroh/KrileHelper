<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KrileHelper.UI.ViewModels"
        xmlns:m="clr-namespace:KrileHelper.UI.Models"
        xmlns:views="clr-namespace:KrileHelper.UI.Views"
        mc:Ignorable="d"
        x:Class="KrileHelper.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Krile Helper (Linux)"
        Width="520" Height="640"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        SystemDecorations="None"
        Topmost="{Binding Topmost}"
        ExtendClientAreaToDecorationsHint="True"
        ShowInTaskbar="True"
        CanResize="True">

    <Border Background="{Binding BackgroundBrush}" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <Border Grid.Row="0"
                    Background="#FF26262C"
                    PointerPressed="OnTitleBarPressed"
                    CornerRadius="8,8,0,0"
                    Padding="12,6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Krile Helper" Foreground="#E5E5E5" FontWeight="SemiBold"/>
                        <TextBlock Text="·" Foreground="#888"/>
                        <TextBlock Text="{Binding ProcessInfo}" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="⚙" Background="Transparent" Foreground="#AAA"
                            BorderThickness="0" Padding="8,2" Click="OnSettingsClick" ToolTip.Tip="Settings"/>
                    <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="#AAA"
                            BorderThickness="0" Padding="8,2" Click="OnCloseClick" ToolTip.Tip="Close"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Background="#FF1F1F25">
                <TabStrip Name="ChatTabStrip" ItemsSource="{Binding ChatTabs.Tabs}"
                          SelectedItem="{Binding ChatTabs.SelectedTab, Mode=TwoWay}"
                          AutomationProperties.Name="Chat tabs">
                    <TabStrip.Styles>
                        <Style Selector="TabStripItem">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="#AAA"/>
                        </Style>
                        <Style Selector="TabStripItem:selected">
                            <Setter Property="Foreground" Value="#FFE6B450"/>
                        </Style>
                    </TabStrip.Styles>
                    <TabStrip.ItemTemplate>
                        <DataTemplate DataType="vm:ChatTabViewModel">
                            <TextBlock Text="{Binding Name}" MaxWidth="160"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </ScrollViewer>

            <!-- Padding lives on this Border, NOT the ScrollViewer: with padding on the
                 ScrollViewer, Avalonia's ScrollContentPresenter arranges the content 2×padding
                 shorter than its measured height, so the scroll extent falls short and the
                 last lines become unreachable (avalonia#12182 class of bug). -->
            <Border Grid.Row="2" Padding="8">
              <Grid>
                <ScrollViewer Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- MaxWidth pins content to the viewport: if a layout pass ever hands an
                         item a slot wider than the window (observed on Linux: last translation
                         rendered unwrapped and clipped at the window edge), the clamp forces
                         re-wrap instead of clipping. -->
                    <ItemsControl Name="ChatItems" ItemsSource="{Binding ChatTabs.SelectedTab.Lines}"
                                  MaxWidth="{Binding Viewport.Width, ElementName=ChatScroll}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="m:ChatLineDisplay">
                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,3">
                                    <TextBlock Grid.Column="0" Text="{Binding TimeStamp, StringFormat='{}{0:HH:mm:ss}'}"
                                               Foreground="#666" FontFamily="Inter,monospace" FontSize="11"
                                               VerticalAlignment="Top" Margin="0,2,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ChannelName}"
                                               Foreground="#5C8DC9" FontFamily="monospace" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Top" Margin="0,2,8,0" MinWidth="50"/>
                                    <StackPanel Grid.Column="2" Spacing="1">
                                        <views:GameTextBlock GameText="{Binding DisplayLine}" Assets="{Binding Assets}"
                                                   Foreground="{Binding Color}" TextWrapping="Wrap"/>
                                        <views:GameTextBlock GameText="{Binding Translation}" Assets="{Binding Assets}"
                                                   Foreground="#FFE6B450" TextWrapping="Wrap" FontStyle="Italic"
                                                   IsVisible="{Binding Translation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="(translating…)"
                                                   Foreground="#777" FontSize="10" FontStyle="Italic"
                                                   IsVisible="{Binding TranslationPending}"/>
                                        <TextBlock Text="{Binding TranslationError, StringFormat='[translation error: {0}]'}"
                                                   Foreground="#CC6666" FontSize="10"
                                                   IsVisible="{Binding TranslationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel IsVisible="{Binding ChatTabs.SelectedTab.IsEmpty}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="320" Margin="16" Spacing="8" IsHitTestVisible="False">
                    <TextBlock Text="No messages in this tab yet." Foreground="#CCC"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Choose this tab's channels in Settings → Overlay tabs. Channel Show / Translate settings still apply."
                               Foreground="#888" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="3" Background="#FF1F1F25" Padding="12,4,4,4" CornerRadius="0,0,8,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding Status}" Foreground="#999" FontSize="11"/>
                        <TextBlock Text="{Binding DialogueStatus}" Foreground="#999" FontSize="10" TextWrapping="Wrap"
                                   IsVisible="{Binding DialogueStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{Binding Hint}" Foreground="#FFB47C" FontSize="10"
                                   IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <!-- Resize grip in bottom-right corner -->
                    <Path Grid.Column="1"
                          Width="14" Height="14"
                          Margin="4,0,4,0"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right"
                          Stroke="#888" StrokeThickness="1.2"
                          Cursor="BottomRightCorner"
                          Data="M 4,14 L 14,4 M 8,14 L 14,8 M 12,14 L 14,12"
                          PointerPressed="OnResizeGripPressed"
                          ToolTip.Tip="Drag to resize"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
